# ==============================================================================
# CineMatch Movie Recommender System - Environment Variables Template
# ==============================================================================
# Copy this file to .env in the project root or configure backend/.env and frontend/.env.
# NEVER commit sensitive API keys or credentials to version control.

# TMDB (The Movie Database) API Key (Free registration at https://www.themoviedb.org/settings/api)
# Used by the Flask backend to fetch movie poster images and details dynamically.
TMDB_API_KEY=your_tmdb_api_key_here

# Backend REST API base URL used by the React + Vite frontend client
VITE_API_BASE_URL=http://127.0.0.1:5000
